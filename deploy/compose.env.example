# Settings for docker compose. Copy to deploy/compose.env (git-ignored).
# DATABASE_URL is set by docker-compose.yml.

# development locally; staging/production require https, PostgreSQL and
# LUPHINA_SECRET_KEYS (the API refuses to start otherwise)
LUPHINA_ENV=development
LUPHINA_PUBLIC_URL=http://localhost:3000

# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LUPHINA_SECRET_KEYS=

# AI (optional)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Run workflows in the worker, not inside API requests
LUPHINA_EXECUTION_MODE=queue

# Email safety switch for the built-in test sender
EMAIL_SEND_ENABLED=false

# Billing (optional)
LUPHINA_STAFF_EMAILS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
