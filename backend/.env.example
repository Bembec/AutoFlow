# Copy this file to backend/.env and fill in your own values.
# Never commit backend/.env.

# --- Airtable CRM ---
AIRTABLE_TOKEN=your_personal_access_token
AIRTABLE_BASE_ID=your_base_id
AIRTABLE_TABLE_NAME=Customers

# --- Gmail (test sending only) ---
EMAIL_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password
EMAIL_TEST_RECIPIENT=your_test_inbox@gmail.com
EMAIL_SEND_ENABLED=false

# --- Gemini AI classification ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite
AI_CLASSIFICATION_ENABLED=false

# --- AI workflow builder / model router ---
# Providers are tried in this order; ones without a key are skipped
AI_PROVIDER_ORDER=gemini,anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium

# --- Optional paths (defaults: backend/data and the sample CSV) ---
# LUPHINA_DATA_DIR=
# LUPHINA_INPUT_CSV=

# --- Environment ---
# development | staging | production (staging/production enforce safe settings)
LUPHINA_ENV=development
# inline: runs execute inside the API request (simple, development)
# queue: the API only queues runs; `python -m luphina.worker` executes them
LUPHINA_EXECUTION_MODE=inline
# Migrate on API start (default: true in development only)
# LUPHINA_AUTO_MIGRATE=
# Origins allowed to call the API directly (not needed behind the web app)
# LUPHINA_CORS_ORIGINS=

# --- Database ---
# Default: SQLite in backend/data/output. Production example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/luphina

# --- Accounts ---
ACCESS_TOKEN_TTL_HOURS=24

# --- Secrets encryption (integration credentials, webhook secrets) ---
# Comma-separated Fernet keys; the first encrypts, all decrypt (rotation).
# Generate one: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Development default: a key file in data/output/secret.key
# LUPHINA_SECRET_KEYS=

# Public address users reach (the web app when it is running), used in
# webhook and OAuth callback URLs, e.g. http://localhost:3000
LUPHINA_PUBLIC_URL=http://127.0.0.1:8000

# --- Google OAuth (for Google Sheets connections) ---
# Redirect URI to register: <LUPHINA_PUBLIC_URL>/oauth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Billing ---
# Plans default to src/luphina/billing/plans.json; override with a file:
# LUPHINA_PLANS_FILE=
# Luphina team members allowed to set plans by hand (invoiced pilots)
LUPHINA_STAFF_EMAILS=
# Stripe (leave empty to disable online payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_BUSINESS=

# --- Shopify Admin API ---
SHOPIFY_API_VERSION=2025-07

# --- Error tracking (optional; also `pip install sentry-sdk`) ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0

# --- API server ---
LUPHINA_API_HOST=127.0.0.1
LUPHINA_API_PORT=8000
